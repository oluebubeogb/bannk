# ─── Bannk environment ─────────────────────────────────────
# Copy to .env for local dev. In Coolify, set these as environment variables.

# PostgreSQL (Coolify: use the internal connection URL of your Postgres resource)
DATABASE_URL="postgresql://bannk:CHANGE_ME@localhost:5432/bannk?schema=public"

# Secrets — generate with: openssl rand -hex 32
SESSION_SECRET="CHANGE_ME_64_hex_chars"
WORDKEY_PEPPER="CHANGE_ME_another_random_string"
# Protects POST /api/cron/allowance (min 16 chars)
CRON_SECRET="CHANGE_ME_random_string"

# Public URL (used in emails and shareable receipt links)
APP_URL="https://bannk.example.com"

# ─── Allowance (integer minor units: NGN has 2 decimals, 100 kobo = ₦1) ───
# Opening balance on verify: ₦1,000,050.00
INITIAL_ALLOWANCE_MINOR=100005000
# Weekly allowance grant AND weekly transfer cap: ₦2,500.00
WEEKLY_ALLOWANCE_MINOR=250000
ALLOWANCE_PERIOD_DAYS=7
ALLOWANCE_TIMEZONE="Africa/Lagos"

# ─── Mail (WordKey + statements) ───────────────────────────
# MAIL_PROVIDER = smtp | resend | console   (auto: resend if RESEND_API_KEY, smtp if SMTP_HOST, else console)
MAIL_PROVIDER="smtp"
MAIL_FROM="Bannk <no-reply@bannk.example.com>"

# SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# Resend (alternative to SMTP)
RESEND_API_KEY=""

# Optional / unused in v1
# REDIS_URL="redis://localhost:6379"

NODE_ENV="production"
